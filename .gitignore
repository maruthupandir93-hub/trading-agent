# dependencies
/node_modules

# Next.js build output
/.next
/out

# local file-backed data stores (trades, decisions, reflections, memory,
# debate records, strategy versions) — see lib/*Store.server.ts. Real
# account/trade data belongs on disk locally, never in version control.
/.data

# TypeScript incremental build info
*.tsbuildinfo

# env files
.env
.env*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Local Oracle VM monitor config (personal OCIDs + ssh key)
scripts/oracle_vm_config.json

# RUNTIME STATE, not source. These were TRACKED, and the app rewrites them on
# every run — so `git pull` on the server aborted with "Your local changes to the
# following files would be overwritten by merge" on every single deploy:
#
#     backend/data/research_report.json
#     backend/data/working_memory.json
#
# All three are created lazily by their own stores (`working_memory`, `ai_memory`,
# `research_agent` each do `if not os.path.exists(...)` then write defaults), so
# untracking them costs a fresh clone nothing. `/.data` above is ignored for the
# same reason; this directory was simply missed.
/backend/data/

# ---------------------------------------------------------------------
# Python build artefacts and the virtualenv (F16)
#
# 277 `__pycache__/*.pyc` files were TRACKED, so every commit — including
# tagged releases — carried binary churn that obscured the real diff, and a
# `.pyc` compiled by one Python version was shipped to a machine running
# another. `.venv` was never ignored either, which is a few hundred megabytes
# one wrong `git add -A` away from the history.
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# The local knowledge-graph SQLite file is written by the test suite (F52)
# and by any local run, so its churn is noise rather than a change.
db/knowledge_graph.db
