# TradingOS AI — environment template. Copy to `.env` and fill in.
# Do not commit the real .env file to version control.
#
# NOTE: this file is UTF-8. A previous version had a UTF-16LE block appended
# into it, so the security section rendered as "S e c u r i t y" with a NUL byte
# after every character — unreadable to a normal .env parser. If you edit this on
# Windows, `Out-File`/`>` default to UTF-16 in some shells: pass `-Encoding utf8`.
#
# Every variable below is read by real code. Defaults shown are what the code
# falls back to when the variable is absent.

# ---------------------------------------------------------------------------
# Execution mode — both default to the SAFE value, so a missing or malformed
# .env produces paper trading against a testnet endpoint, never live orders.
# ---------------------------------------------------------------------------
# The single switch that decides whether orders reach an exchange.
# Toggleable at runtime from the dashboard Settings page, which writes it back
# here so the change survives a restart. (default: false)
LIVE_TRADING=false
# (default: true) Private Binance calls FAIL while this is true — Binance dropped
# futures testnet support in ccxt. Public endpoints (tickers, klines) work fine.
USE_TESTNET=true

# ---------------------------------------------------------------------------
# Autonomous pipeline gates. Both default OFF and are independent of each other.
# ---------------------------------------------------------------------------
# Off: the execution service still validates, quantises and records a receipt,
# but publishes no TAR — so the whole chain is observable without a graph run
# being able to submit anything. CLOSES IGNORE THIS FLAG, deliberately: a flag
# that gated exits would trap the operator in positions while it was off.
# (default: false)
GRAPH_EXECUTION_ENABLED=false
# Off: the monitoring graph still runs and logs every decision in full; only the
# ACTION is withheld. Stop-loss enforcement is never gated by this — that lives
# in PositionMonitorAgent and runs on every tick. (default: false)
POSITION_MONITORING_ENABLED=false

# ---------------------------------------------------------------------------
# Exchange API keys
# ---------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_SECRET=
BYBIT_API_KEY=
BYBIT_SECRET=

# ---------------------------------------------------------------------------
# Intelligence layer
# ---------------------------------------------------------------------------
# NO ADAPTER IS WIRED YET. `backend/llm/provider.py` defaults to NullProvider,
# which refuses honestly rather than returning fallback prose, so every LLM node
# reports "no answer" until an adapter exists. Setting a key alone does not
# change that. (default: unset -> NullProvider)
LLM_PROVIDER=
OPENAI_API_KEY=
NEWS_API_KEY=

# Optional market-data providers used by the Next.js side.
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
ALPACA_API_KEY=

# ---------------------------------------------------------------------------
# Polymarket prediction-market feed
# ---------------------------------------------------------------------------
# DEFAULTS OFF, and not merely for caution: enabling it CHANGES EVERY CONFIDENCE
# NUMBER THE SYSTEM PRODUCES, because registering a directional specialist raises
# the coverage denominator on every run — including runs where it has nothing to
# say. See the long comment in backend/core/config.py. (default: false)
POLYMARKET_ENABLED=false

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_RETRIES=3
# Fraction of equity risked per trade — the risk BUDGET, not the position size.
# 0.02 means a trade whose stop is hit loses 2% of equity. (default: 0.02)
RISK_PER_TRADE=0.02
# LangGraph checkpointer backend. Only the monitoring graph checkpoints; the
# others have nothing to resume. (default: sqlite)
GRAPH_CHECKPOINTER=sqlite

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Read by BOTH halves. Without it the backend boots with an in-memory book that
# is lost on restart, and the browser falls back to localStorage / .data JSON.
# (default: postgresql://postgres:postgres@localhost:5432/tradingos)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradingos
DATABASE_SSL=
DATABASE_POOL_MAX=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# API key the Next.js layer sends to the FastAPI backend.
TRADES_API_KEY=
# HTTP Basic password for the dashboard (middleware.ts). If unset, the dashboard
# is OPEN — intended for local dev only.
DASHBOARD_PASSWORD=
# Encrypts the local secret store. The fallback is literally
# "default_insecure_master" — set this before any deployment.
MASTER_PASSWORD=

# ---------------------------------------------------------------------------
# Cross-origin / split deployment
# ---------------------------------------------------------------------------
# Comma-separated; overrides the default list ENTIRELY. Defaults cover
# localhost AND 127.0.0.1 on ports 3000/3001/3100 — those are DIFFERENT ORIGINS
# to a browser, and having only one of them listed made every backend call fail
# preflight while the backend was running perfectly.
ALLOWED_ORIGINS=
# FastAPI origin, baked in at build time for the browser bundle.
# (default: http://localhost:8000)
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_TRADES_API_KEY=
